# Drama Series Agent — local env

DRAMA_SERIES_ROOT=
COMFYUI_URL=http://127.0.0.1:8188

# ffmpeg: tail-frame extract + shot concat (chain continuity)
# Resolve order: FFMPEG_PATH → PATH → imageio-ffmpeg (bundled with pip install)
# Windows examples:
#   winget install --id Gyan.FFmpeg -e
#   FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# macOS: brew install ffmpeg
# Linux: sudo apt install -y ffmpeg
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Optional LLM (agent chat)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
